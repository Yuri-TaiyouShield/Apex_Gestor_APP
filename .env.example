# Apex Gestor local development defaults.
# Copy to .env and change secrets before any shared or production environment.

DB_PASSWORD=change_me_before_use
DB_PORT=2705
API_PORT=8080

# Development can use update. Production must use validate after migrations are in place.
JPA_DDL_AUTO=update

# Keep false only for local demos. Production must set true.
APEX_SECURITY_REQUIRE_AUTH=false

APEX_CORS_ALLOWED_ORIGINS=http://localhost:*,https://localhost:*,http://127.0.0.1:*,https://127.0.0.1:*,app://localhost,ionic://localhost,capacitor://localhost
