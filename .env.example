# Apex Gestor local development defaults.
# Copy to .env and change secrets before any shared or production environment.

DB_PASSWORD=change_me_before_use
DB_PORT=2705
API_PORT=8080

# Production must use validate after migrations are in place.
JPA_DDL_AUTO=validate
APEX_JWT_SECRET=replace-with-at-least-32-random-characters
APEX_JWT_ISSUER=apex-gestor
APEX_JWT_AUDIENCE=apex-api

# Authentication is required by default.
APEX_SECURITY_REQUIRE_AUTH=true

APEX_CORS_ALLOWED_ORIGINS=http://localhost:*,https://localhost:*,http://127.0.0.1:*,https://127.0.0.1:*,app://localhost,ionic://localhost,capacitor://localhost
